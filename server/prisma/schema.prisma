// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum MissionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MilestoneState {
  LOCKED
  ACTIVE
  COMPLETED
  LOST
  RECLAIMING
  RECLAIMED
}

enum ReclaimStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

// --------------------------------------------------------
// MODELS
// --------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  missions Mission[]
}

model Mission {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      MissionStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([userId])
}

model Milestone {
  id          String         @id @default(uuid())
  missionId   String
  order       Int
  title       String
  description String?
  state       MilestoneState @default(LOCKED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  tasks       Task[]
  reclaimLogs ReclaimLog[]

  @@unique([missionId, order])
  @@index([missionId])
}

model Task {
  id          String    @id @default(uuid())
  milestoneId String
  title       String
  description String?
  points      Int       @default(1)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model ReclaimLog {
  id            String        @id @default(uuid())
  milestoneId   String
  attemptNumber Int
  status        ReclaimStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  resolvedAt    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}
